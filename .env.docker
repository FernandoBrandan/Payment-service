NODE_ENV=localprod
PORT=3002

# Database
DB_HOST=postgres
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=payment
DB_LOGGING=false
# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# rabbitmq
EVENT_BUS_DRIVER=rabbitmq
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=ecommerce

# Payments
PAYMENT_PROVIDER=mercadopago
PAYMENT_TIMEOUT_MS=5000

PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_RETRY_BASE_MS=500
PAYMENT_RETRY_MAX_MS=4000

PAYMENT_CB_THRESHOLD=5
PAYMENT_CB_RESET_MS=30000

PAYMENT_BH_MAX_CONCURRENT=10
PAYMENT_BH_MAX_QUEUE=20
PAYMENT_BH_QUEUE_TIMEOUT_MS=5000

MERCADOPAGO_API=
MERCADOPAGO_ACCESS_TOKEN=change_mechange_mechange_mechange_mechange_me
WEBHOOK_URL=
SUCCESS_URL=
FAILURE_URL=
PENDING_URL=
MERCADOPAGO_WEBHOOK_SECRET=

FAKE_PAYMENT_OUTCOME=approved
FAKE_PAYMENT_DELAY_MS=3000
FAKE_PAYMENT_GENERATION_DELAY_MS=0

FAKE_PAYMENT_TIMEOUT_RATE=0.20
FAKE_PAYMENT_FAILURE_RATE=0.10

# Auth
JWT_SECRET=change_mechange_mechange_mechange_mechange_me
JWT_EXPIRES_IN=1d

# Logging
LOG_LEVEL=info
SERVICE_NAME=payment-api

# Reconciliation (Fase 2)
RECONCILIATION_ENABLED=true
RECONCILIATION_WINDOW_MINUTES=60
RECONCILIATION_BATCH_SIZE=50
